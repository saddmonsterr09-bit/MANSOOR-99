PORT=3000
# Create a Google OAuth Web application client ID and authorize your website origin.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
R2_BUCKET=personal
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Keep the SQLite file on persistent storage, outside the publicly served site folder.
DATABASE_PATH=../openframe-data/openframe.sqlite
