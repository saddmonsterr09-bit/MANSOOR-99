{
  "name": "mansoor-99",
  "main": "./cloudflare-worker.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": false
  },
  "r2_buckets": [
    {
      "binding": "VIDEOS",
      "bucket_name": "personal"
    }
  ]
}
